rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && !request.resource.data.keys().hasAny(['role', 'isAdmin']);
      allow update: if owns(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']);

      match /tasks/{taskId} {
        allow read, create, update, delete: if owns(uid);
      }

      // Telegram chatId và trạng thái liên kết chỉ được backend Admin SDK truy cập.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // Mã liên kết Telegram chỉ backend được phép truy cập.
    match /telegramLinkCodes/{code} {
      allow read, write: if false;
    }
  }
}
